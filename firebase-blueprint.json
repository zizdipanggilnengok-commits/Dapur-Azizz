{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "Profil pengguna Dapur Aziz yang terhubung ke Firebase Auth, menyimpan data pribadi dan peran akses.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "UID Firebase Authentication milik pengguna.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nama_lengkap": {
          "type": "string",
          "description": "Nama lengkap pelanggan atau admin.",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Alamat email pengguna.",
          "minLength": 3,
          "maxLength": 160
        },
        "no_hp": {
          "type": "string",
          "description": "Nomor WhatsApp atau telepon aktif pelanggan.",
          "minLength": 0,
          "maxLength": 30
        },
        "alamat": {
          "type": "string",
          "description": "Alamat pengantaran makanan.",
          "minLength": 0,
          "maxLength": 300
        },
        "role": {
          "type": "string",
          "description": "Peran akses pengguna.",
          "enum": ["admin", "user"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan profil."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan profil terakhir."
        }
      },
      "required": ["id", "nama_lengkap", "email", "no_hp", "alamat", "role", "created_at", "updated_at"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Dokumen penanda hak akses administrator Dapur Aziz.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "created_at"]
    },
    "Product": {
      "title": "Product",
      "description": "Item menu makanan atau minuman di katalog Dapur Aziz.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nama_produk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kategori": {
          "type": "string",
          "enum": ["Makanan", "Minuman"]
        },
        "harga": {
          "type": "number"
        },
        "deskripsi": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400
        },
        "gambar_url": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "tersedia": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "nama_produk", "kategori", "harga", "deskripsi", "gambar_url", "tersedia", "created_at", "updated_at"]
    },
    "Order": {
      "title": "Order",
      "description": "Transaksi pesanan pelanggan Dapur Aziz.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nama_pelanggan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "no_hp": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "alamat_pengiriman": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "total_harga": {
          "type": "number"
        },
        "jumlah_item": {
          "type": "number"
        },
        "ringkasan_menu": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "status_pesanan": {
          "type": "string",
          "enum": ["Menunggu Konfirmasi", "Dimasak", "Selesai", "Dibatalkan"]
        },
        "catatan": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "user_id",
        "nama_pelanggan",
        "no_hp",
        "alamat_pengiriman",
        "total_harga",
        "jumlah_item",
        "ringkasan_menu",
        "status_pesanan",
        "catatan",
        "created_at",
        "updated_at"
      ]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "Detail item menu dalam satu transaksi pesanan Dapur Aziz.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "order_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "product_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nama_produk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "harga_satuan": {
          "type": "number"
        },
        "qty": {
          "type": "number"
        },
        "subtotal": {
          "type": "number"
        }
      },
      "required": ["id", "order_id", "user_id", "product_id", "nama_produk", "harga_satuan", "qty", "subtotal"]
    },
    "Rating": {
      "title": "Rating",
      "description": "Penilaian bintang (1-5) dan ulasan pelanggan untuk menu Dapur Aziz.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "product_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nama_pengulas": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "rating": {
          "type": "number"
        },
        "ulasan": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "product_id",
        "user_id",
        "nama_pengulas",
        "rating",
        "ulasan",
        "created_at",
        "updated_at"
      ]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": { "$ref": "#/entities/Profile" },
      "description": "Profil pengguna dan peran RBAC ('admin' atau 'user')."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Daftar UID administrator terverifikasi."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Katalog menu makanan dan minuman Dapur Aziz."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Data transaksi pesanan pelanggan."
    },
    "/orders/{orderId}/order_items/{itemId}": {
      "schema": { "$ref": "#/entities/OrderItem" },
      "description": "Relasi detail item per pesanan."
    },
    "/ratings/{ratingId}": {
      "schema": { "$ref": "#/entities/Rating" },
      "description": "Penilaian dan ulasan pelanggan per item menu."
    }
  }
}
